    {
      "name": "molehd",
      "description": "MoleHD clasico sobre BBBP, ejecutado en copia temporal para no contaminar outputs.",
      "datasets": ["bbbp", "bace", "clintox", "hiv", "mutag", "nci1", "ncl1", "ptc_fm", "sider", "tox21"],
      "workspace_copy_from": "Tesis-PolymerHDC/src/molehd",
      "cwd_in_workspace": ".",
      "docker": {
        "image": "general-molehd",
        "build_context": "Tesis-PolymerHDC/src/molehd",
        "dockerfile": "Tesis-PolymerHDC/src/molehd/runtime/Dockerfile",
        "platform": "linux/amd64",
        "workdir": "/tesis",
        "mounts": [
          {
            "source": "{workspace_root}",
            "target": "/tesis"
          },
          {
            "source": "{repo_root}",
            "target": "/repo"
          },
          {
            "source": "{run_output_dir}",
            "target": "/run_outputs"
          },
          {
            "source": "{repo_root}/Mole-BERT",
            "target": "/molebert"
          }
        ],
        "run_args": [
          "python",
          "/tesis/original/MoleHD.py",
          "--dataset_file",
          "{molehd_dataset_path}",
          "--target",
          "{target_column}",
          "--mols",
          "{molecule_column}",
          "--num_tokens",
          "500",
          "--dim",
          "10048",
          "--max_pos",
          "256",
          "--gramsize",
          "3",
          "--retraining_epochs",
          "20",
          "--iterations",
          "100",
          "--test_size",
          "20",
          "--threshold",
          "256",
          "--encoding_scheme",
          "characterwise",
          "--split_type",
          "random_stratified",
          "--version",
          "general_run"
        ]
      },
      "summary_patterns": [
        "_workspace/outputs/metrics_dict_*.p",
        "_workspace/outputs/detailed_results_*.csv"
      ]
    },
    {
