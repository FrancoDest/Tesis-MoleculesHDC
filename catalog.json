        "run_args": [
          "python",
          "/tesis/Tesis-PolymerHDC/src/mol2vec_jl/jl_pipeline/run_bbbp_jl_pipeline.py",
          "--embeddings-csv",
          "{embeddings_csv}",
          "--labels-csv",
