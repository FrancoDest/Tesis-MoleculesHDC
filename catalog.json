  "methods": [
    {
      "name": "random_forest_rdkit",
      "description": "Random Forest con descriptores RDKit sobre datasets binarios tipo BBBP/MUTAG.",
      "datasets": [
        "bbbp",
        "bace",
        "clintox",
        "hiv",
        "sider",
        "refractive_index",
        "glass_transition_ratio"
      ],
      "cwd": "Tesis-PolymerHDC/src/smiles_pipelines/random_forest_rdkit",
      "docker": {
        "image": "general-random-forest-rdkit",
        "build_context": "Tesis-PolymerHDC/src/smiles_pipelines/random_forest_rdkit",
        "dockerfile": "Tesis-PolymerHDC/src/smiles_pipelines/random_forest_rdkit/runtime/Dockerfile",
        "platform": "linux/amd64",
        "workdir": "/tesis/Tesis-PolymerHDC/src/smiles_pipelines/random_forest_rdkit",
        "mounts": [
          {
            "source": "{repo_root}",
            "target": "/tesis"
          },
          {
            "source": "{run_output_dir}",
            "target": "/run_outputs"
          }
        ],
        "run_args": [
          "--dataset",
          "{rf_dataset_path}",
          "--target-column",
          "{target_column}",
          "--smiles-column",
          "{molecule_column}",
          "--iterations",
          "100",
          "--random-state",
          "800",
          "--output-dir",
          "/run_outputs/artifacts",
          "--frac-a-column",
          "{frac_a_column}",
          "--frac-b-column",
          "{frac_b_column}",
          "--group-column",
          "{group_column}"
        ]
      },
      "summary_patterns": [
        "_outputs/artifacts/metrics.json",
        "_outputs/artifacts/detailed_results.csv"
      ]
    },
