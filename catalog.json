        "platform": "linux/amd64",
        "workdir": "/tesis/Tesis-PolymerHDC/src/mol2vec_jl",
        "mounts": [
          {
            "source": "{repo_root}",
            "target": "/tesis"
          },
          {
            "source": "{run_output_dir}",
            "target": "/run_outputs"
          }
