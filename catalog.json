  "methods": [
    {
      "name": "random_forest_rdkit",
      "description": "Random Forest con descriptores RDKit sobre datasets binarios tipo BBBP/MUTAG.",
      "datasets": ["bbbp", "bace", "clintox", "hiv", "mutag", "nci1", "ncl1", "ptc_fm", "sider", "tox21"],
      "cwd": "Tesis-PolymerHDC/src/random_forest_rdkit",
      "docker": {
        "image": "general-random-forest-rdkit",
        "build_context": "Tesis-PolymerHDC/src/random_forest_rdkit",
        "dockerfile": "Tesis-PolymerHDC/src/random_forest_rdkit/runtime/Dockerfile",
        "platform": "linux/amd64",
        "workdir": "/tesis/Tesis-PolymerHDC/src/random_forest_rdkit",
        "mounts": [
          {
            "source": "{repo_root}",
            "target": "/tesis"
          },
          {
            "source": "{run_output_dir}",
            "target": "/run_outputs"
          }
        ],
        "run_args": [
          "--dataset",
          "{rf_dataset_path}",
          "--target-column",
          "{target_column}",
          "--smiles-column",
          "{molecule_column}",
          "--iterations",
          "100",
          "--output-dir",
          "/run_outputs/artifacts"
        ]
      },
      "summary_patterns": [
        "_outputs/artifacts/metrics.json",
        "_outputs/artifacts/detailed_results.csv"
      ]
    },
    {
      "name": "mole_bert_hdc",
      "description": "Pipeline completo Mole-BERT -> JL -> HDC sobre BBBP.",
      "datasets": ["bbbp", "bace", "clintox", "hiv", "mutag", "nci1", "ncl1", "ptc_fm", "sider", "tox21"],
      "cwd": "Tesis-PolymerHDC/src/mole_bert_hdc",
      "docker": {
        "image": "general-molebert-hdc",
        "build_context": "Tesis-PolymerHDC/src/mole_bert_hdc",
        "dockerfile": "Tesis-PolymerHDC/src/mole_bert_hdc/hdc_pipeline/Dockerfile",
        "platform": "linux/amd64",
        "workdir": "/tesis/Tesis-PolymerHDC/src/mole_bert_hdc",
        "mounts": [
          {
            "source": "{repo_root}",
            "target": "/tesis"
          },
          {
            "source": "{run_output_dir}",
            "target": "/run_outputs"
          }
        ],
        "run_args": [
          "python",
          "hdc_pipeline/run_hdc_pipeline.py",
          "--input-csv",
          "{molebert_input_csv}",
          "--target-column",
          "{target_column}",
          "--smiles-column",
          "{molecule_column}",
          "--checkpoint",
          "/tesis/Tesis-PolymerHDC/src/mole_bert_hdc/original/model_gin/Mole-BERT.pth",
          "--iterations",
          "100",
          "--jl-dim",
          "10048",
          "--output-dir",
          "/run_outputs/artifacts"
        ]
      },
      "summary_patterns": [
        "_outputs/artifacts/*_hdc_metrics.json",
        "_outputs/artifacts/*_hdc_test_predictions.csv"
      ]
    },
    {
